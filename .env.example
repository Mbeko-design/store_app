# Server-only variables for Vercel Functions. Set real values in the Vercel
# project environment; never commit them or prefix secrets with VITE_.
APP_ORIGIN=https://your-production-domain.example
APP_SESSION_SECRET=generate-a-random-secret-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret

# Vercel injects BLOB_STORE_ID / OIDC credentials after connecting a private
# Blob store to this project. They are intentionally not configured in Vite.
