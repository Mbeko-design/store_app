# Server configuration (copy to .env if needed)
PORT=8787
HOST=0.0.0.0
# Where the Postgres (PGlite) data lives — back this folder up daily
MIZAN_DATA_DIR=./data
# Optional: fixed JWT secret (otherwise generated once into dataDir/jwt.secret)
MIZAN_JWT_SECRET=
# CORS: * (default) or comma-separated origins, e.g. https://store.example.com
CORS_ORIGIN=*
